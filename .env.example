# ──────────────────────────────────────────────────────────────
# Copy this file to ".env.local" and fill in real values.
# All NEXT_PUBLIC_* vars are INLINED INTO THE CLIENT BUNDLE and visible to
# anyone who opens the site. Only put values here that are safe to be
# public. Never put a Cloudinary API secret, a database password, or
# any true secret in a NEXT_PUBLIC_ variable — those belong on a backend.
# When deploying, set these in your host (Vercel/Netlify/etc.) and redeploy —
# Next.js inlines them at build time.
# ──────────────────────────────────────────────────────────────

# Firebase web config — public by design; secure your data with Firebase Security Rules
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxx
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Cloudinary — use an UNSIGNED upload preset for client uploads (no API secret needed)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset

# Certificate mailer (optional overrides)
NEXT_PUBLIC_CERT_MAILER_URL=/api/send-certificate-emails
NEXT_PUBLIC_CERT_MAIL_API_KEY=

# Admin login — WARNING: this is a client-side check and offers no real security.
# Anyone can read it from the bundle. Replace with real (server-side) auth.
NEXT_PUBLIC_ADMIN_USERNAME=admin
NEXT_PUBLIC_ADMIN_PASSWORD=change-me

# ──────────────────────────────────────────────────────────────
# SERVER-SIDE ONLY — certificate email API route
# (src/app/api/send-certificate-emails/route.ts). NEVER prefix these with
# NEXT_PUBLIC_. Required for the admin "email certificates" feature; if they
# are unset, only that route returns 500 — the rest of the site is unaffected.
# ──────────────────────────────────────────────────────────────
SMTP_USER=your-mailbox@gmail.com
SMTP_PASS=your-app-password
# SMTP_SERVICE=gmail                                # optional: nodemailer preset (e.g. gmail)
# SMTP_HOST=smtp.gmail.com                          # optional: used instead of SMTP_SERVICE
# SMTP_PORT=465                                     # optional: defaults to 465
# SMTP_FROM=E-Cell <no-reply@ecell.ipsacademy.org>  # optional: defaults to SMTP_USER
# ADMIN_API_KEY=                                    # optional: shared secret; must equal NEXT_PUBLIC_CERT_MAIL_API_KEY
# CORS_ORIGIN=                                      # optional: only if this route is called cross-origin

# ──────────────────────────────────────────────────────────────
# SERVER-SIDE ONLY — used by `npm run seed:admin` (NOT the web app).
# These are NOT NEXT_PUBLIC_ vars, so they are never bundled into the client.
# The service-account key is a true secret — keep the JSON file out of git.
# ──────────────────────────────────────────────────────────────
FIREBASE_SERVICE_ACCOUNT=./serviceAccountKey.json
SEED_ADMIN_EMAIL=admin@ecell.ipsacademy.org
SEED_ADMIN_PASSWORD=a-strong-password
SEED_ADMIN_NAME=E-Cell Admin
SEED_ADMIN_ROLE=Super Admin
